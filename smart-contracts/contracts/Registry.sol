pragma solidity ^0.8.20;

/// @title PrivacyPreservingRegistry
/// @notice Anyone can store a record, but uploader info is not stored.
contract Registry {

    struct Record {
        string eCID;    // encrypted CID
        bytes eDEK;     // encrypted DEK
        bytes32 dHash;  // data hash
        uint256 time;   // block.timestamp
    }

    // mapping from recordId => Record
    mapping(bytes32 => Record) private records;

    // optional: keep all recordIds for enumeration
    bytes32[] public recordIds;

    /// @notice Emitted when a record is stored
    event RecordStored(bytes32 indexed recordId, uint256 time);

    /// @notice Store a record. recordId is generated by the uploader off-chain
    /// @param recordId unique id generated by uploader (can be keccak256(eCID + salt))
    /// @param eCID encrypted CID
    /// @param eDEK encrypted DEK
    /// @param dHash hash of the data
    
    function storeRecord(
        bytes32 recordId,
        string calldata eCID,
        bytes calldata eDEK,
        bytes32 dHash
    ) external {
        require(bytes(records[recordId].eCID).length == 0, "record already exists");

        records[recordId] = Record({
            eCID: eCID,
            eDEK: eDEK,
            dHash: dHash,
            time: block.timestamp
        });

        recordIds.push(recordId);
        emit RecordStored(recordId, block.timestamp);
    }

    /// @notice Get a record by its recordId
    function getRecord(bytes32 recordId)
        external
        view
        returns (string memory eCID, bytes memory eDEK, bytes32 dHash, uint256 time)
    {
        Record storage r = records[recordId];
        require(bytes(r.eCID).length != 0, "record not found");
        return (r.eCID, r.eDEK, r.dHash, r.time);
    }

    /// @notice Total number of records stored
    function totalRecords() external view returns (uint256) {
        return recordIds.length;
    }
}
